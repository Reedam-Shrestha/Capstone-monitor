# schedmon.service — Real-Time Performance Monitoring Daemon
#
# INSTALL:
#   sudo make install                          # builds and copies to /opt/schedmon/
#   sudo cp schedmon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now schedmon
#
# VIEW OUTPUT:
#   journalctl -u schedmon -f
#
# CHECK STATUS:
#   systemctl status schedmon

[Unit]
Description=schedmon Real-Time Performance Monitoring Daemon
Documentation=https://github.com/group4/schedmon
# Start after the kernel's BPF subsystem and filesystem are available.
# network.target not required — daemon is local-only.
After=local-fs.target
# If the classifier or ghOSt agent are separate services, uncomment:
# Before=schedmon_classifier.service schedmon_ghost_agent.service
# Don't restart more than 5 times in 60 seconds — prevents crash loop thrash.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple

# Per-core mode is ON by default in the binary.
# Add --no-per-core here for VMs where hardware PMU counters are unavailable.
ExecStart=/opt/schedmon/schedmon \
    /opt/schedmon/bpf/ctx_switch.bpf.o \
    --interval 50

# Working directory for any relative path resolution
WorkingDirectory=/opt/schedmon

# Run as root so perf_event_open and bpf() syscalls succeed.
# Alternative: run as non-root with the capabilities below — requires
# kernel 5.9+ and sysctl kernel.perf_event_paranoid <= 2.
User=root
Group=root

# Capabilities needed:
#   CAP_PERFMON        — perf_event_open() for hardware counters (kernel 5.9+)
#   CAP_BPF            — load and attach eBPF programs (kernel 5.8+)
#   CAP_SYS_ADMIN      — REMOVED. Covered by CAP_BPF and CAP_PERFMON on
#                        kernel >= 5.8/5.9. Do NOT re-add unless on older kernel.
#   CAP_DAC_READ_SEARCH — read /proc/<pid>/ entries owned by other users.
#   CAP_SYS_PTRACE     — read /proc/<pid>/io for any process.
AmbientCapabilities=CAP_PERFMON CAP_BPF CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_PERFMON CAP_BPF CAP_DAC_READ_SEARCH CAP_SYS_PTRACE

# File descriptor limit.
LimitNOFILE=65536

# Memory lock limit for mmap'd shared memory ring buffers (~6MB total, 8MB headroom).
LimitMEMLOCK=8388608

# Restart on crash/OOM, not on clean exit (SIGTERM).
Restart=on-failure
RestartSec=2s

# Log stdout/stderr to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=schedmon

# Create the log directory if it doesn't exist.
RuntimeDirectory=schedmon
LogsDirectory=schedmon
LogsDirectoryMode=0755

# Security hardening.
NoNewPrivileges=yes
ProtectSystem=strict
# Allow writing to /dev/shm (ring buffers) and /var/log/schedmon (CSV output).
ReadWritePaths=/dev/shm /var/log/schedmon
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
